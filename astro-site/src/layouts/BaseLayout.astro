		<style>
			html, body {
				min-height: 100%;
				margin: 0;
				padding: 0;
			}
			body {
				font-family: 'Poppins', Arial, sans-serif;
				background: url('/img/sfondo-mare-2.jpg') top center no-repeat, linear-gradient(135deg, #e0f2fe 0%, #f7fbff 60%, #fff 100%);
				background-size: cover, auto;
				color: #1e293b;
				font-size: 1.08em;
				line-height: 1.7;
				min-height: 100vh;
				padding-top: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			main {
				background: rgba(255,255,255,0.95);
				border-radius: 22px;
				box-shadow: 0 8px 32px rgba(14,165,233,0.08);
				padding: 32px 18px 48px;
				margin: 32px auto 48px auto;
				max-width: 980px;
			}
			@media (max-width: 700px) {
				main {
					padding: 18px 2vw 32px;
					margin: 16px 0 32px 0;
				}
			}
		
				/* HERO SPIAGGE - riutilizzabile */
				.hero-spiagge {
					position: relative;
					width: 100vw;
					left: 50%;
					right: 50%;
					margin-left: -50vw;
					margin-right: -50vw;
					min-height: 340px;
					background: url('/img/porto-selvaggio/porto-selvaggio.jpg') center center/cover no-repeat;
					display: flex;
					align-items: center;
					justify-content: center;
					margin-bottom: 32px;
					overflow: hidden;
					border-radius: 0;
					box-shadow: none;
				}
				.hero-overlay {
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					background: linear-gradient(135deg, rgba(14,165,233,0.65) 0%, rgba(2,132,199,0.55) 100%);
					z-index: 1;
				}
				.hero-content {
					position: relative;
					z-index: 2;
					text-align: center;
					color: #fff;
					padding: 20px;
					width: 100%;
					max-width: 700px;
				}
				.spiagge-salento-title {
					margin-top: 0 !important;
					font-size: 2.4em;
					font-weight: 700;
					color: #fff;
					text-shadow: 0 2px 16px rgba(14,165,233,0.18);
				}
				.hero-desc {
					font-size: 1.18em;
					margin-top: 18px;
					margin-bottom: 0;
					color: #e0f2fe;
					text-shadow: 0 1px 8px rgba(14,165,233,0.13);
				}
				@media (max-width: 700px) {
					.hero-spiagge {
						min-height: 220px;
						border-radius: 0;
					}
					.hero-content {
						padding: 48px 8px 18px;
						padding-top: 64px;
					}
					.spiagge-salento-title {
						font-size: 1.3em;
						margin-top: 0 !important;
					}
					.hero-desc {
						font-size: 1em;
					}
				}
				</style>
	

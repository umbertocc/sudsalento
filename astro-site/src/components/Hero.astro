---
// Hero.astro: componente hero riutilizzabile per banner con immagine di sfondo, overlay e testo
const { image = '', title = '', description = '', overlayColor = 'linear-gradient(135deg, rgba(14,65,120,0.82) 0%, rgba(2,80,120,0.74) 100%)', h1MarginTop = '40px' } = Astro.props;
---
<div class="hero-spiagge" style={image ? `background-image: url('${image}'); padding: 20px;` : 'padding: 20px;'}>
  <div class="hero-overlay" style={`background: ${overlayColor};`}></div>
  <div class="hero-content">
    <h1 class="spiagge-salento-title" style={`margin-top: ${h1MarginTop};`}>{title}</h1>
    <p class="hero-desc">{description}</p>
  </div>
</div>

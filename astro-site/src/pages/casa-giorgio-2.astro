---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <Fragment slot="head">
    <title>Casa Giorgio 2 – Torre Pali | Affitti Salento</title>
    <meta name="description" content="Casa Giorgio 2 a Torre Pali: primo piano a 40 metri dalla spiaggia, 3 camere, doppia veranda (una vista mare), aria condizionata, lavatrice. Galleria foto e dettagli." />
    <link rel="canonical" href="https://umbertocc.github.io/sudsalento/casa-giorgio-2" />
  </Fragment>
  <SiteNav />
  <main style="max-width:900px; margin:0 auto; padding:32px 16px 48px; min-height:60vh;">
    <h1 style="font-size:2em; color:#1e293b; margin-top:58px; margin-bottom:18px;">Casa Giorgio 2 – Torre Pali - Salento</h1>
    <p style="font-size:0.98em; color:#1e293b; margin-bottom:10px;">CIN: IT075066C200123459 | CIS: LE07506691000075734</p>
    <p style="font-size:1.1em; color:#334155; margin-bottom:24px;">Primo piano a 40 metri dalla spiaggia di Torre Pali, 3 camere, soggiorno con angolo cottura, doppia veranda (una vista mare), aria condizionata, lavatrice. Posto auto, vicinissimo a tutti i servizi e alle Maldive del Salento. Ideale per famiglie e gruppi.</p>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.15em; color:#1e293b; margin-bottom:12px;">Galleria Foto</h2>
      <div class="gallery-grid">
        <img src="/sudsalento/img/casa-giorgio2/prospetto.webp" alt="Prospetto Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/prospetto2.webp" alt="Prospetto 2 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/balcone.webp" alt="Balcone Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/balcone2.webp" alt="Balcone 2 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/balcone3.webp" alt="Balcone 3 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/balcone4.webp" alt="Balcone 4 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/balcone-mobile.webp" alt="Balcone mobile Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/ingresso.webp" alt="Ingresso Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/scala.webp" alt="Scala Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/soggiorno.webp" alt="Soggiorno Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/soggiorno2.webp" alt="Soggiorno 2 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/camera.webp" alt="Camera Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/camera2.webp" alt="Camera 2 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/camera3.webp" alt="Camera 3 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/camera4.webp" alt="Camera 4 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/camera5.webp" alt="Camera 5 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/camera6.webp" alt="Camera 6 Casa Giorgio 2">
        <img src="/sudsalento/img/casa-giorgio2/bagno.webp" alt="Bagno Casa Giorgio 2">
      </div>
      <div id="modal" class="modal" style="display:none;">
        <span class="close" id="closeModal">&times;</span>
        <img class="modal-content" id="modalImg" src="" alt="Foto ingrandita">
      </div>
      <style>
        .gallery-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
          gap: 16px;
          margin-top: 10px;
        }
        .gallery-grid img {
          width: 100%;
          height: 140px;
          object-fit: cover;
          border-radius: 10px;
          box-shadow: 0 2px 12px rgba(14,165,233,0.08);
          transition: transform 0.2s, opacity 0.7s;
          cursor: pointer;
          opacity: 0;
          transform: translateY(24px);
        }
        .gallery-grid img.visible {
          opacity: 1;
          transform: translateY(0);
        }
        .gallery-grid img:hover {
          transform: scale(1.04);
          box-shadow: 0 4px 18px rgba(14,165,233,0.18);
        }
        @media (max-width: 600px) {
          .gallery-grid {
            grid-template-columns: 1fr 1fr;
          }
          .gallery-grid img {
            height: 90px;
          }
        }
        .modal {
          display: none;
          position: fixed;
          z-index: 9999;
          padding-top: 60px;
          left: 0;
          top: 0;
          width: 100vw;
          height: 100vh;
          overflow: auto;
          background-color: rgba(0,0,0,0.85);
        }
        .modal-content {
          margin: auto;
          display: block;
          max-width: 90vw;
          max-height: 80vh;
          border-radius: 12px;
          box-shadow: 0 4px 32px rgba(14,165,233,0.18);
        }
        .close {
          position: absolute;
          top: 24px;
          right: 38px;
          color: #fff;
          font-size: 2.5em;
          font-weight: bold;
          cursor: pointer;
          z-index: 10001;
          text-shadow: 0 2px 8px #000;
        }
        .close:hover { color: #38bdf8; }
      </style>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const images = document.querySelectorAll('.gallery-grid img');
          const modal = document.getElementById('modal');
          const modalImg = document.getElementById('modalImg');
          const closeModal = document.getElementById('closeModal');
          images.forEach(img => {
            img.addEventListener('click', function() {
              modal.style.display = 'block';
              modalImg.src = this.src;
              modalImg.alt = this.alt;
            });
          });
          closeModal.onclick = function() {
            modal.style.display = 'none';
            modalImg.src = '';
          };
          window.onclick = function(event) {
            if (event.target === modal) {
              modal.style.display = 'none';
              modalImg.src = '';
            }
          };
          // Fade-in on scroll
          const revealImages = () => {
            images.forEach(img => {
              const rect = img.getBoundingClientRect();
              if (rect.top < window.innerHeight - 40) {
                img.classList.add('visible');
              }
            });
          };
          revealImages();
          window.addEventListener('scroll', revealImages);
        });
      </script>
    </section>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Indirizzo</h2>
      <p style="color:#334155; font-size:1em; margin-bottom:18px;">Via Vasco de Gama, 13, Torre Pali (LE)</p>
      <div style="margin-bottom:18px;">
        <iframe
          src="https://www.google.com/maps?q=Via+Vasco+de+Gama+13,+Torre+Pali,+Salve+LE,+Italia&output=embed"
          width="100%" height="280" style="border:0; border-radius:12px; box-shadow:0 2px 12px rgba(14,165,233,0.10);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mappa Casa Giorgio 2"
        ></iframe>
      </div>
    </section>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Richiedi Disponibilità</h2>
      <a href="/sudsalento/contatti" style="display:inline-block; background:#0ea5e9; color:#fff; padding:12px 28px; border-radius:8px; text-decoration:none; font-weight:600;">Contattaci per questa casa</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

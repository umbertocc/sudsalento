---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import SalentoMapLeaflet from '../components/SalentoMapLeaflet.astro';
---
<BaseLayout>
  <SiteNav guideHref="/spiagge-salento/" />
  <Hero
    
    title="Spiagge del Salento: panoramica completa"
    description="Il Salento offre una varietà di spiagge tra le più belle d'Italia, sia sulla costa ionica che su quella adriatica. Dalle distese sabbiose alle scogliere, ogni località ha caratteristiche uniche: mare cristallino, fondali bassi, pinete, grotte e panorami mozzafiato. In questa pagina trovi una panoramica delle principali spiagge del Salento, con link di approfondimento per ciascuna località."
    h1MarginTop="80px"
  />
  <main class="container">
    <section style = 'padding: 20px'>
      <h2>Spiagge principali del Salento</h2>
      <ul>
        <li>Torre Vado: marina pittoresca con piscina naturale e porto turistico.</li>
        <li>Torre Pali: Bandiera Blu, Isola della Fanciulla, spiagge per famiglie.</li>
        <li>Pescoluse: le famose "Maldive del Salento", sabbia bianca e fondali bassi.</li>
        <li>Lido Marini: pineta mediterranea, spiaggia tranquilla e servizi.</li>
        <li>Marina di Felloniche: baia sabbiosa e acqua limpida.</li>
        <li>Santa Maria di Leuca: punto d'incontro tra Ionio e Adriatico, faro e grotte.</li>
        <li>Torre Mozza: spiaggia naturale e torre costiera storica.</li>
        <li>Torre San Giovanni: lunghe spiagge sabbiose, porto e servizi.</li>
        <li>Gallipoli: spiagge sabbiose, movida e centro storico sul mare.</li>
        <li>Porto Cesareo: spiagge bianche, isole e area marina protetta.</li>
        <li>Porto Selvaggio: parco naturale, pineta e scogliere a picco sul mare.</li>
        <li>Castro: grotte marine, scogliera e acque profonde e limpide.</li>
        <li>Punta Prosciutto: sabbia bianca e mare caraibico.</li>
        <li>Eventi e attività: scopri cosa fare sulle spiagge del Salento.</li>
        <li>Guida completa alle spiagge</li>
      </ul>
    </section>
    <SalentoMapLeaflet />
    <section style = 'padding:20px'>
      <h2>Appendice: tutte le spiagge del progetto</h2>
      <p>Di seguito trovi i link diretti alle pagine dedicate alle singole spiagge e località balneari presenti nel sito:</p>
      <ul>
        <li><a href="/torre-vado/">Torre Vado</a></li>
        <li><a href="/torre-pali/">Torre Pali</a></li>
        <li><a href="/pescoluse/">Pescoluse</a></li>
        <li><a href="/lido-marini/">Lido Marini</a></li>
        <li><a href="/marina-di-felloniche/">Marina di Felloniche</a></li>
        <li><a href="/santa-maria-di-leuca/">Santa Maria di Leuca</a></li>
        <li><a href="/torre-mozza/">Torre Mozza</a></li>
        <li><a href="/torre-san-giovanni/">Torre San Giovanni</a></li>
        <li><a href="/gallipoli/">Gallipoli</a></li>
        <li><a href="/porto-cesareo/">Porto Cesareo</a></li>
        <li><a href="/porto-selvaggio/">Porto Selvaggio</a></li>
        <li><a href="/castro/">Castro</a></li>
        <li><a href="/punta-prosciutto/">Punta Prosciutto</a></li>
      </ul>
    </section>
  </main>
  <SiteFooter guideHref="/spiagge-salento/" placeHtml="Salento, Puglia" />
</BaseLayout>

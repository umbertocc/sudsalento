---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <Fragment slot="head">
    <title>Casa Giorgio 6 – Torre Pali | Affitti Salento</title>
    <meta name="description" content="Casa Giorgio 6 a Torre Pali: primo piano a 40 metri dalla spiaggia, 3 camere, doppia veranda (una vista mare), aria condizionata, lavatrice. Galleria foto e dettagli." />
    <link rel="canonical" href="https://umbertocc.github.io/sudsalento/casa-giorgio-6/" />
   <!-- Open Graph Tags -->
    <meta property="og:title" content="Casa Vacanza Torre Pali – Casa Giorgio 6 | Affitti Salento" />
    <meta property="og:description" content="Casa Vacanza Torre Pali: quadrilocale al primo piano a 40 metri dalla spiaggia, ideale per famiglie e gruppi. Galleria foto, dettagli e servizi." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://umbertocc.github.io/sudsalento/casa-giorgio-6/" />
    <meta property="og:image" content="https://umbertocc.github.io/sudsalento/img/casa-giorgio/prospetto.webp" />
    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Casa Vacanza Torre Pali – Casa Giorgio 6 | Affitti Salento" />
    <meta name="twitter:description" content="Casa Vacanza Torre Pali: quadrilocale al primo piano a 40 metri dalla spiaggia, ideale per famiglie e gruppi. Galleria foto, dettagli e servizi." />
    <meta name="twitter:image" content="https://umbertocc.github.io/sudsalento/img/casa-giorgio/prospetto.webp" />
  </Fragment>
  <SiteNav />
  <main style="max-width:900px; margin:0 auto; padding:32px 16px 48px; min-height:60vh;">
    <h1 style="font-size:2em; color:#1e293b; margin-top:58px; margin-bottom:18px;">Casa Giorgio 6 – Torre Pali - Salento</h1>
    <p style="font-size:0.98em; color:#1e293b; margin-bottom:10px;">CIN: IT075066C200123459 | CIS: LE07506691000075734</p>
    <p style="font-size:1.1em; color:#334155; margin-bottom:24px;">Primo piano a 40 metri dalla spiaggia di Torre Pali, 3 camere, soggiorno con angolo cottura, doppia veranda (una vista mare), aria condizionata, lavatrice. Posto auto, vicinissimo a tutti i servizi e alle Maldive del Salento. Ideale per famiglie e gruppi.</p>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.15em; color:#1e293b; margin-bottom:12px;">Galleria Foto</h2>
      <div class="gallery-grid">
        <img src="/sudsalento/img/casa-giorgio2/prospetto.webp" alt="Prospetto Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/prospetto2.webp" alt="Prospetto 2 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/balcone.webp" alt="Balcone Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/balcone2.webp" alt="Balcone 2 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/balcone3.webp" alt="Balcone 3 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/balcone4.webp" alt="Balcone 4 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/balcone-mobile.webp" alt="Balcone mobile Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/ingresso.webp" alt="Ingresso Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/scala.webp" alt="Scala Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/soggiorno.webp" alt="Soggiorno Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/soggiorno2.webp" alt="Soggiorno 2 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/camera.webp" alt="Camera Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/camera2.webp" alt="Camera 2 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/camera3.webp" alt="Camera 3 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/camera4.webp" alt="Camera 4 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/camera5.webp" alt="Camera 5 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/camera6.webp" alt="Camera 6 Casa Giorgio 6">
        <img src="/sudsalento/img/casa-giorgio2/bagno.webp" alt="Bagno Casa Giorgio 6">
      </div>
      <div id="modal" class="modal" style="display:none;">
        <span class="close" id="closeModal">&times;</span>
        <button id="prevImg" class="modal-nav" style="left:18px;">&#10094;</button>
        <img class="modal-content" id="modalImg" src="" alt="Foto ingrandita">
        <button id="nextImg" class="modal-nav" style="right:18px;">&#10095;</button>
      </div>
      <style>
        .gallery-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
          gap: 16px;
          margin-top: 10px;
        }
        .gallery-grid img {
          width: 100%;
          height: 140px;
          object-fit: cover;
          border-radius: 10px;
          box-shadow: 0 2px 12px rgba(14,165,233,0.08);
          transition: transform 0.2s, opacity 0.7s;
          cursor: pointer;
          opacity: 0;
          transform: translateY(24px);
        }
        .gallery-grid img.visible {
          opacity: 1;
          transform: translateY(0);
        }
        .gallery-grid img:hover {
          transform: scale(1.04);
          box-shadow: 0 4px 18px rgba(14,165,233,0.18);
        }
        @media (max-width: 600px) {
          .gallery-grid {
            grid-template-columns: 1fr 1fr;
          }
          .gallery-grid img {
            height: 90px;
          }
        }
        .modal {
          display: none;
          position: fixed;
          z-index: 9999;
          padding-top: 60px;
          left: 0;
          top: 0;
          width: 100vw;
          height: 100vh;
          overflow: auto;
          background-color: rgba(0,0,0,0.85);
        }
        .modal-content {
          margin: auto;
          display: block;
          max-width: 90vw;
          max-height: 80vh;
          border-radius: 12px;
          box-shadow: 0 4px 32px rgba(14,165,233,0.18);
        }
        .modal-nav {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          background: rgba(14,165,233,0.7);
          border: none;
          color: #fff;
          font-size: 2.2em;
          padding: 0 16px;
          border-radius: 8px;
          cursor: pointer;
          z-index: 10001;
          transition: background 0.2s;
        }
        .modal-nav:hover {
          background: #0284c7;
        }
        .close {
          position: absolute;
          top: 24px;
          right: 38px;
          color: #fff;
          font-size: 2.5em;
          font-weight: bold;
          cursor: pointer;
          z-index: 10001;
          text-shadow: 0 2px 8px #000;
        }
        .close:hover { color: #38bdf8; }
      </style>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const images = Array.from(document.querySelectorAll('.gallery-grid img'));
          const modal = document.getElementById('modal');
          const modalImg = document.getElementById('modalImg');
          const closeModal = document.getElementById('closeModal');
          const prevBtn = document.getElementById('prevImg');
          const nextBtn = document.getElementById('nextImg');
          let currentIndex = 0;

          function showModal(index) {
            currentIndex = index;
            modal.style.display = 'block';
            modalImg.src = images[index].src;
            modalImg.alt = images[index].alt;
          }

          images.forEach((img, idx) => {
            img.addEventListener('click', function() {
              showModal(idx);
            });
          });

          function showNext() {
            currentIndex = (currentIndex + 1) % images.length;
            showModal(currentIndex);
          }
          function showPrev() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            showModal(currentIndex);
          }

          nextBtn.onclick = showNext;
          prevBtn.onclick = showPrev;

          closeModal.onclick = function() {
            modal.style.display = 'none';
            modalImg.src = '';
          };
          window.onclick = function(event) {
            if (event.target === modal) {
              modal.style.display = 'none';
              modalImg.src = '';
            }
          };

          window.addEventListener('keydown', function(e) {
            if (modal.style.display === 'block') {
              if (e.key === 'ArrowRight') showNext();
              if (e.key === 'ArrowLeft') showPrev();
              if (e.key === 'Escape') closeModal.onclick();
            }
          });

          // Fade-in on scroll
          const revealImages = () => {
            images.forEach(img => {
              const rect = img.getBoundingClientRect();
              if (rect.top < window.innerHeight - 40) {
                img.classList.add('visible');
              }
            });
          };
          revealImages();
          window.addEventListener('scroll', revealImages);
        });
      </script>
    </section>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Indirizzo</h2>
      <p style="color:#334155; font-size:1em; margin-bottom:18px;">Via Vasco de Gama, 13, Torre Pali (LE)</p>
      <div style="margin-bottom:18px;">
        <iframe
          src="https://www.google.com/maps?q=Via+Vasco+de+Gama+13,+Torre+Pali,+Salve+LE,+Italia&output=embed"
          width="100%" height="280" style="border:0; border-radius:12px; box-shadow:0 2px 12px rgba(14,165,233,0.10);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mappa Casa Giorgio 6"
        ></iframe>
      </div>
    </section>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Caratteristiche</h2>
      <ul style="color:#334155; font-size:1em; margin-left:18px; margin-bottom:18px;">
        <li>3 camere da letto</li>
        <li>1 bagno</li>
        <li>Doppia veranda (una vista mare)</li>
        <li>Area esterna attrezzata</li>
        <li>1 posto auto</li>
        <li>Aria condizionata</li>
        <li>Lavatrice</li>
        <li>40 metri dalla spiaggia</li>
        <li>Vicino a tutti i servizi</li>
        <li>1 posto auto</li>
        <li>Primo piano</li>
      </ul>
    </section>
    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Richiedi Disponibilità</h2>
      <a href="/sudsalento/contatti" style="display:inline-block; background:#0ea5e9; color:#fff; padding:12px 28px; border-radius:8px; text-decoration:none; font-weight:600;">Contattaci per questa casa</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

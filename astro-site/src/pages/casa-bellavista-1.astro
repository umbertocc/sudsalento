---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Fragment slot="head">
    <title>Casa Bellavista 1 - Torre Pali | Affitti Salento</title>
    <meta name="description" content="Casa Bellavista 1 a Torre Pali: appartamento al primo piano in centro, a 100 metri dalla spiaggia. 2 camere, 5 posti letto, veranda panoramica attrezzata e servizi completi." />
    <meta name="keywords" content="casa bellavista 1, torre pali, affitti salento, casa vacanza torre pali, appartamento 5 posti, veranda panoramica, maldive del salento" />
    <link rel="canonical" href="https://umbertocc.github.io/sudsalento/casa-bellavista-1/" />
    <meta property="og:title" content="Casa Bellavista 1 - Torre Pali | Affitti Salento" />
    <meta property="og:description" content="Primo piano in centro a 100 metri dalla spiaggia sabbiosa di Torre Pali, con veranda panoramica attrezzata e 5 posti letto." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://umbertocc.github.io/sudsalento/casa-bellavista-1/" />
    <meta property="og:image" content="https://umbertocc.github.io/sudsalento/img/casa-bellavista-1/prospetto.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Casa Bellavista 1 - Torre Pali | Affitti Salento" />
    <meta name="twitter:description" content="Appartamento al primo piano in centro a Torre Pali, 5 posti letto, vicino alla spiaggia e alle Maldive del Salento." />
    <meta name="twitter:image" content="https://umbertocc.github.io/sudsalento/img/casa-bellavista-1/prospetto.webp" />
  </Fragment>

  <SiteNav />

  <main style="max-width:900px; margin:0 auto; padding:32px 16px 48px; min-height:60vh;">
    <h1 style="font-size:2em; color:#1e293b; margin-top:58px; margin-bottom:18px;">Casa Bellavista 1 - Torre Pali - Salento</h1>
    <p style="font-size:0.98em; color:#64748b; margin-bottom:10px;">CIN: IT075066C200071293 - CIS: LE07506691000031092</p>
    <p style="font-size:1.1em; color:#334155; margin-bottom:24px;">Casa Bellavista 1 e un appartamento al primo piano, in pieno centro, a soli 100 metri dalla spiaggia sabbiosa di Torre Pali e a 3 minuti in auto dalle Maldive del Salento. In zona tranquilla, offre spazi comodi per famiglie e gruppi fino a 5 persone.</p>

    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.15em; color:#1e293b; margin-bottom:12px;">Galleria Foto</h2>
      <div class="gallery-grid">
        <img src="/sudsalento/img/casa-bellavista-1/prospetto.webp" alt="Prospetto Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/prospetto.jpg" alt="Prospetto frontale Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/prospetto2.jpg" alt="Prospetto 2 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/prospetto_mare.jpg" alt="Vista mare Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/scale.jpg" alt="Vano scala Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/corridoio.jpg" alt="Corridoio Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/corridoio1.jpg" alt="Corridoio 2 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/cucina.jpg" alt="Vano cottura Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/camera.jpg" alt="Camera matrimoniale 1 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/camera2.jpg" alt="Camera matrimoniale 2 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/camera3.jpg" alt="Camera con letto singolo Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/seconda-camera.jpg" alt="Seconda camera Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/secondacamera2.jpg" alt="Seconda camera 2 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/bagno.jpg" alt="Bagno Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/bagno2.jpg" alt="Bagno 2 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/veranda.jpg" alt="Veranda Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/veranda2.jpg" alt="Veranda 2 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/veranda3.jpg" alt="Veranda 3 Casa Bellavista 1">
        <img src="/sudsalento/img/casa-bellavista-1/veranda4.jpg" alt="Veranda 4 Casa Bellavista 1">
      </div>

      <div id="modal" class="modal" style="display:none;">
        <span class="close" id="closeModal">&times;</span>
        <button id="prevImg" class="modal-nav" style="left:18px;">&#10094;</button>
        <img class="modal-content" id="modalImg" src="" alt="Foto ingrandita">
        <button id="nextImg" class="modal-nav" style="right:18px;">&#10095;</button>
      </div>

      <style>
        .gallery-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
          gap: 16px;
          margin-top: 10px;
        }
        .gallery-grid img {
          width: 100%;
          height: 140px;
          object-fit: cover;
          border-radius: 10px;
          box-shadow: 0 2px 12px rgba(14,165,233,0.08);
          transition: transform 0.2s, opacity 0.7s;
          cursor: pointer;
          opacity: 0;
          transform: translateY(24px);
        }
        .gallery-grid img.visible {
          opacity: 1;
          transform: translateY(0);
        }
        .gallery-grid img:hover {
          transform: scale(1.04);
          box-shadow: 0 4px 18px rgba(14,165,233,0.18);
        }
        @media (max-width: 600px) {
          .gallery-grid {
            grid-template-columns: 1fr 1fr;
          }
          .gallery-grid img {
            height: 90px;
          }
        }
        .modal {
          display: none;
          position: fixed;
          z-index: 9999;
          padding-top: 60px;
          left: 0;
          top: 0;
          width: 100vw;
          height: 100vh;
          overflow: auto;
          background-color: rgba(0,0,0,0.85);
        }
        .modal-content {
          margin: auto;
          display: block;
          max-width: 90vw;
          max-height: 80vh;
          border-radius: 12px;
          box-shadow: 0 4px 32px rgba(14,165,233,0.18);
        }
        .modal-nav {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          background: rgba(14,165,233,0.7);
          border: none;
          color: #fff;
          font-size: 2.2em;
          padding: 0 16px;
          border-radius: 8px;
          cursor: pointer;
          z-index: 10001;
          transition: background 0.2s;
        }
        .modal-nav:hover {
          background: #0284c7;
        }
        .close {
          position: absolute;
          top: 24px;
          right: 38px;
          color: #fff;
          font-size: 2.5em;
          font-weight: bold;
          cursor: pointer;
          z-index: 10001;
          text-shadow: 0 2px 8px #000;
        }
        .close:hover { color: #38bdf8; }
      </style>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const images = Array.from(document.querySelectorAll('.gallery-grid img'));
          const modal = document.getElementById('modal');
          const modalImg = document.getElementById('modalImg');
          const closeModal = document.getElementById('closeModal');
          const prevBtn = document.getElementById('prevImg');
          const nextBtn = document.getElementById('nextImg');
          let currentIndex = 0;

          function showModal(index) {
            currentIndex = index;
            modal.style.display = 'block';
            modalImg.src = images[index].src;
            modalImg.alt = images[index].alt;
          }

          images.forEach((img, idx) => {
            img.addEventListener('click', function() {
              showModal(idx);
            });
          });

          function showNext() {
            currentIndex = (currentIndex + 1) % images.length;
            showModal(currentIndex);
          }
          function showPrev() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            showModal(currentIndex);
          }

          nextBtn.onclick = showNext;
          prevBtn.onclick = showPrev;

          closeModal.onclick = function() {
            modal.style.display = 'none';
            modalImg.src = '';
          };
          window.onclick = function(event) {
            if (event.target === modal) {
              modal.style.display = 'none';
              modalImg.src = '';
            }
          };

          window.addEventListener('keydown', function(e) {
            if (modal.style.display === 'block') {
              if (e.key === 'ArrowRight') showNext();
              if (e.key === 'ArrowLeft') showPrev();
              if (e.key === 'Escape') closeModal.onclick();
            }
          });

          const revealImages = () => {
            images.forEach(img => {
              const rect = img.getBoundingClientRect();
              if (rect.top < window.innerHeight - 40) {
                img.classList.add('visible');
              }
            });
          };
          revealImages();
          window.addEventListener('scroll', revealImages);
        });
      </script>
    </section>

    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Caratteristiche</h2>
      <ul style="color:#334155; font-size:1em; margin-left:18px; margin-bottom:18px;">
        <li>Primo piano in pieno centro</li>
        <li>100 metri dalla spiaggia sabbiosa di Torre Pali</li>
        <li>2 camere grandi con 2 letti matrimoniali e 1 letto singolo</li>
        <li>5 posti letto totali</li>
        <li>Vano scala ampio e vano cottura</li>
        <li>Spazio esterno panoramico attrezzato con tavolo, sedie, divano e TV SAT</li>
        <li>Bagno con doccia</li>
        <li>Climatizzatore</li>
        <li>Microonde e lavatrice</li>
        <li>Pass per parcheggio gratuito sotto casa</li>
        <li>A 3 minuti in auto dalle Maldive del Salento</li>
      </ul>
    </section>

    <section style="margin-bottom:32px;">
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Posizione</h2>
      <p style="color:#334155; font-size:1em; margin-bottom:18px;">Viale Colleoni, 55, Torre Pali (LE)</p>
      <div style="margin-bottom:18px;">
        <iframe
          src="https://www.google.com/maps?q=Viale+Colleoni+55,+Torre+Pali,+Salve+LE,+Italia&output=embed"
          width="100%" height="280" style="border:0; border-radius:12px; box-shadow:0 2px 12px rgba(14,165,233,0.10);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mappa Casa Bellavista 1"
        ></iframe>
      </div>
    </section>

    <section>
      <h2 style="font-size:1.1em; color:#1e293b; margin-bottom:10px;">Richiedi Disponibilita</h2>
      <a href="/sudsalento/contatti" style="display:inline-block; background:#0ea5e9; color:#fff; padding:12px 28px; border-radius:8px; text-decoration:none; font-weight:600;">Contattaci per questa casa</a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
